{
  "manifest_version": 3,
  "name": "HireTree Clip",
  "version": "0.1.0",
  "description": "Clip job offers and send them to HireTree.",
  "permissions": ["activeTab", "scripting", "cookies"],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HireTree Clip"
  }
}
